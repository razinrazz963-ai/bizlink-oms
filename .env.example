# ==============================================================================
# BIZLINK OMS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to configure production environment variables in your hosting provider.
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel Project Settings > Environment Variables)
# ------------------------------------------------------------------------------
# The public HTTPS URL of your deployed Express backend API service.
# Example: https://bizlink-api.onrender.com
VITE_API_URL=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render / Railway / VPS / Cloud Hosting)
# ------------------------------------------------------------------------------
# Network port on which the Express server listens (assigned automatically by cloud hosts)
PORT=

# Secret key used for signing and verifying JSON Web Tokens (JWT) for staff sessions
JWT_SECRET=

# Allowed frontend origin for Cross-Origin Resource Sharing (CORS)
# Example: https://bizlink-phi.vercel.app
CORS_ORIGIN=

# Initial System Administrator credentials (used when database initializes)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Optional: Persistent data directory path (for persistent disk mounts on Render/Railway/VPS)
DATA_DIR=

# Optional: Persistent uploads directory path for customer KYC and legal documents
UPLOADS_DIR=
